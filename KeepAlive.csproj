<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KeepAlive</AssemblyName>
    <RootNamespace>KeepAlive</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Permite compilarea pentru Windows și de pe Linux/macOS. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Publish: un singur exe. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Iconița exe-ului (Explorer, taskbar). Generată din PNG cu tools/make_icons.py. -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Iconița de tray, inclusă în exe ca resursă. -->
    <EmbeddedResource Include="Resources\app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
